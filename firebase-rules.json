{
  "rules": {
    ".read": false,
    ".write": false,
    "morabarabaRooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid && newData.child('players').child(auth.uid).child('seat').val() === 1) || (data.exists() && data.child('hostUid').val() === auth.uid && !newData.exists()))",
        "hostUid": {
          ".validate": "newData.isString()"
        },
        "boardType": {
          ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid",
          ".validate": "newData.val() === 'classic' || newData.val() === 'diagonal'"
        },
        "status": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists()",
          ".validate": "newData.val() === 'waiting' || newData.val() === 'playing'"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.hasChildren(['name','seat']) && newData.child('name').isString() && newData.child('name').val().length > 0 && (newData.child('seat').val() === 1 || newData.child('seat').val() === 2))"
          }
        },
        "game": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists()"
        }
      }
    }
  }
}
